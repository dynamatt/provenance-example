{{/* Validation report (provenance-ddf DES-0049), rendered by
     `provenance validate --output validation.html`. Written beside the
     exported site (--output validation.html=_site/validation.html), it uses
     the site's stylesheet and its links are relative to the site's main
     page. Lists every built-in check and rule, passed or not, then every
     violation, linked to its entity. */ -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Validation — {{.Component.Code}} DHF</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="dhf-header">
<a class="dhf-home" href="index.html">{{.Component.Name}}</a>
<span class="dhf-label">Design History File · {{.Component.Code}}</span>
</header>
<main class="dhf-main">
<h1>Validation</h1>
<p class="dhf-intro">{{.Summary.Errors}} error{{if ne .Summary.Errors 1}}s{{end}}, {{.Summary.Warnings}} warning{{if ne .Summary.Warnings 1}}s{{end}}
{{- with .Summary.RulesSkipped}}; {{.}} rule{{if ne . 1}}s{{end}} not run{{end}}.</p>

<h2>Checks and rules</h2>
<table>
<thead><tr><th>Check</th><th>Severity</th><th>Result</th></tr></thead>
<tbody>
{{- range .Rules}}
<tr><td><code>{{.ID}}</code><br>{{.Message}}</td><td>{{.Severity}}</td><td>
{{- if .Skipped}}<span class="status status-skipped">not run</span> {{.Skipped}}
{{- else if not .Violations}}<span class="status status-approved">passed</span>
{{- else}}<span class="status status-{{.Severity}}">{{len .Violations}} violation{{if ne (len .Violations) 1}}s{{end}}</span>
{{- end}}</td></tr>
{{- end}}
</tbody>
</table>

<h2>Violations</h2>
{{- with .Violations}}
<table>
<thead><tr><th>Entity</th><th>Where</th><th>Check</th><th>Message</th></tr></thead>
<tbody>
{{- range .}}
<tr><td>{{link .Entity}}</td><td><code>{{.Path}}{{with .Line}}:{{.}}{{end}}</code></td><td><span class="status status-{{.Severity}}">{{.Severity}}</span> <code>{{.Rule}}</code></td><td>{{.Message}}</td></tr>
{{- end}}
</tbody>
</table>
{{- else}}
<p class="none">None.</p>
{{- end}}
</main>
<footer class="dhf-footer">
Generated by <code>provenance validate</code>.
{{- with .GitSHA}}
<p class="dhf-stamp">From commit <code>{{short .}}</code>
{{- with $.ContentHash}} · content hash <code>{{.}}</code>{{end}}</p>
{{- end}}
</footer>
</body>
</html>
