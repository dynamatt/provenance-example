{{/* equipment-used — a named presentation template: a piece of
     TestEquipment as one row of the report's equipment table (DOC-0005),
     with every unit of it the verification evidence records: serial
     number, calibration due date and the execution it was used in. The
     units are the Equipment rows linking back to it (.used_in, then each
     evidence's .equipment_used rows whose .equipment is this one).
     Validation evidence uses the same record and is left out here.
     Joined into one table as device-under-test.tmpl describes. */}}
{{- $eq := . -}}
<table class="joined-rows" id="{{.ID}}">
<colgroup><col style="width: 34%"><col style="width: 20%"><col style="width: 46%"></colgroup>
<thead><tr><th>Equipment</th><th>Model</th><th>Units used</th></tr></thead>
<tbody><tr>
<td>{{link .}}: {{.Title}}</td>
<td>{{.model}}</td>
<td>
{{- range $ev := .used_in}}{{if eq $ev.Type "VerificationEvidence"}}
{{- range $row := $ev.equipment_used}}{{with $row.equipment}}{{if eq .ID $eq.ID}}
<div class="unit">{{$row.serial_number}} · calibration due {{$row.calibration_due_date}} · used in {{link $ev}}</div>
{{- end}}{{end}}{{end}}{{end}}{{end}}
</td>
</tr></tbody>
</table>
