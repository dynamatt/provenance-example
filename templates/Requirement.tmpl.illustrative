{{/* Detailed Design §7: templates hold layout only; markdown conversion and
     heading depth are template functions (heading(N) resolved to a concrete
     hN at generation time), not expressed in the template itself. Stored
     links (e.g. .Implements below) are already-resolved fields on the
     entity data passed in — no live query needed to render a Requirement's
     own links; a live query is only for a Document's query blocks
     (High-Level Design §4.3a), a different rendering context from this. */}}
<article id="{{.ID}}">
  <{{heading 1}}>{{.Title}}</{{heading 1}}>
  <p><strong>Status:</strong> {{.Status}}</p>
  {{markdown .Statement}}
  {{if .Rationale}}<p><em>Rationale:</em> {{markdown .Rationale}}</p>{{end}}
  <{{heading 2}}>Implements</{{heading 2}}>
  <ul>
    {{range .Implements}}
      <li><a href="#{{.ID}}">{{.ID}}: {{.Title}}</a></li>
    {{end}}
  </ul>
</article>
