{{/* The site's main page (Detailed Design §7). Receives .Component and
     .Types: every entity grouped by type (types by name, entities by ID),
     each entity with the same fields a type template sees. Not every type
     has a status, so it is read with `index`, which gives nothing for a
     field the type does not declare. */}}
<h1>{{.Component.Name}} ({{.Component.Code}})</h1>
<p class="dhf-intro">Design history file for component <strong>{{.Component.Code}}</strong>:
user needs, requirements, design, risk and verification, with every link between them.</p>
{{range .Types}}
<section class="dhf-type">
<h2>{{.Type}}</h2>
<table>
<thead><tr><th>ID</th><th>Title</th><th>Status</th></tr></thead>
<tbody>
{{- range .Entities}}
<tr><td>{{link .}}</td><td>{{.Title}}</td><td>{{with index . "Status"}}<span class="status status-{{.}}">{{.}}</span>{{end}}</td></tr>
{{- end}}
</tbody>
</table>
</section>
{{end}}
